#include <winver.h>

IDI_APP ICON "mausely.ico"
1 24 "mausely.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Mausely hand-gesture mouse"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductName", "Mausely"
      VALUE "ProductVersion", "0.1.0"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "mausely.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
